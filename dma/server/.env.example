# Environment: production | development. Normally taken from "environment" in dma/dma.config.json
# (changes with a push + git pull). Set DMA_ENV here only to pin THIS server regardless of the file -
# recommended on the live online server. It sets the EktaHR login service, the online server and
# whether MONGODB_URI may be used.
DMA_ENV=production

PORT=2005

# Server mode, normally from "serverMode" in dma/dma.config.json (online for the repo server):
# lan = office server on the admin's PC; online = the public server (track.ektahr.com behind HTTPS):
# employees on any network, LAN_ONLY and UDP discovery off, agent/viewer tokens required.
# Set it here only to override the config file for this server.
# DMA_MODE=online
# Token secret. Optional on the online server: without it, the server creates its own random secret
# once (server/storage/.jwt-secret) - it never uses the old public default.
# Generate your own: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=

# EktaHR login service and online server come from the environment (dma/dma.config.json): production =
# https://my.ektahr.com, development = https://uat.ektahr.com.

# Development only: the old DEV_HRMS database, checked first for logins. Ignored in production.
# MONGODB_URI=

# Office LAN server only (DMA_MODE=lan): reject connections from non-private IPs
LAN_ONLY=true

# DMA monitoring files (screenshots, idle logs) are stored on disk here, not in MongoDB
# DMA_STORAGE_DIR=D:/ektahr-dma-storage   (optional; default is dma/server/storage)
# Days of screenshots kept, including today (1 = today only; older day-folders deleted hourly)
SCREENSHOT_RETENTION_DAYS=1

# Idle time: no mouse/keyboard input for this many seconds = IDLE (idle screenshot, badge, admin alert).
# Agents get this from the server automatically; change here and restart the server. 300 = 5 minutes.
IDLE_THRESHOLD_SECONDS=300
